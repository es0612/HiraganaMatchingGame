      <PreActions>
         <ExecutionAction
            ActionType="Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title="Auto increment build number"
               scriptText="set -euo pipefail

# Prefer CI-provided build number if available (e.g., Xcode Cloud)
if [[ -n \"${CI_BUILD_NUMBER:-}\" ]]; then
  NEW_BUILD_NUMBER=\"${CI_BUILD_NUMBER}\"
else
  # Fallback to total git commit count
  if command -v git >/dev/null 2>&1; then
    NEW_BUILD_NUMBER=\"$(git rev-list --count HEAD || echo 1)\"
  else
    NEW_BUILD_NUMBER=\"$CURRENT_PROJECT_VERSION\"
  fi
fi

echo \"Setting build number to ${NEW_BUILD_NUMBER}\"
xcrun agvtool new-version -all \"${NEW_BUILD_NUMBER}\"
" 
               shellToUse="/bin/sh">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier="primary"
                     BlueprintIdentifier="D5041D7F2DFA8F43005F71CC"
                     BuildableName="HiraganaMatchingGame.app"
                     BlueprintName="HiraganaMatchingGame"
                     ReferencedContainer="container:HiraganaMatchingGame.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
   </ArchiveAction>
