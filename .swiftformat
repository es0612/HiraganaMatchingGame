# SwiftFormat 設定 - 現代的 Swift スタイルガイド準拠
# https://github.com/nicklockwood/SwiftFormat

# Swift バージョン
--swiftversion 6.0

# 基本ルール
--rules redundantSelf
--rules redundantParens  
--rules redundantReturn
--rules trailingCommas
--rules indent
--rules linebreaks
--rules spaceAroundOperators
--rules spaceInsideBrackets
--rules spaceInsideParens
--rules consecutiveSpaces

# 除外ルール
--disable blankLinesAtEndOfScope
--disable wrapMultilineStatementBraces

# 設定オプション
--indent 4
--ifdef indent
--maxwidth 140
--commas inline
--trimwhitespace always
--insertlines true
--removelines true
--elseposition same-line
--guardelse same-line

# 除外パス  
--exclude app/HiraganaMatchingGame/Assets.xcassets
--exclude app/HiraganaMatchingGame.xcodeproj
--exclude app/build
--exclude docs
--exclude .github

