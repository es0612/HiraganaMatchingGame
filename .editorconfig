# EditorConfig helps maintain consistent coding styles
# More info: https://editorconfig.org

# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Swift files
[*.swift]
indent_size = 4
max_line_length = 140

# SwiftUI and Swift Package files
[*.{swift,swiftui}]
indent_size = 4

# Swift Package Manager
[Package.swift]
indent_size = 4

# Xcode project files
[*.{pbxproj,xcworkspacedata,xcuserstate}]
indent_style = tab
indent_size = 4

# Xcode scheme files
[*.xcscheme]
indent_style = tab

# Configuration files
[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.plist]
indent_size = 2
indent_style = tab

# Scripts
[*.{sh,bash,zsh,fish}]
indent_size = 2

# Documentation
[*.{md,txt}]
indent_size = 2
max_line_length = 80

# Ignore generated and binary files
[{*.xcassets,*.app,*.framework,*.dylib,*.a}/**]
trim_trailing_whitespace = false
insert_final_newline = false